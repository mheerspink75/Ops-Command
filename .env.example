# OpsCommand environment variables (development defaults).
# Copy to .env and adjust. Never commit real secrets.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=OpsCommand

# --- Security (REQUIRED in production) ---
# Use a long random string in production, e.g. `openssl rand -hex 32`.
SECRET_KEY=insecure-dev-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Database ---
# Note: the Docker Compose Postgres is exposed on host port 5433 to avoid
# clashing with a locally installed Postgres on 5432.
DATABASE_URL=postgresql+psycopg://opscommand:opscommand@localhost:5433/opscommand

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Login throttling ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Observability ---
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
METRICS_ENABLED=true
